# Keeps the build context small AND keeps secrets out of image layers.
# Without this file, `COPY . .` ships .env and .git into the image.
node_modules
.next
out
build
.git
.env
.env.*
!.env.example
.vscode
*.log

# The landing page is a separate app with its own Dockerfile. Without this line
# it would be copied into this image — and its node_modules into this context.
Landing-Page
