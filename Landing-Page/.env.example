# Copy to .env.local for local dev. In Railway these are SERVICE variables
# (runtime), never build args.

# Optional. Railway injects PORT=8080 if you don't set this. Whatever it ends up
# being, Railway's target port must match it or you get 502 Bad Gateway.
# PORT=3000

# Must stay 0.0.0.0 in a container — the default binds to localhost, which is
# unreachable from outside the container.
# HOSTNAME=0.0.0.0

# Where the "Get plan" CTA sends people. Leave unset while the landing page
# ships alone; set it to the app's origin (e.g. https://app.yourdomain.com)
# once the app service is live. BUILD time, not runtime: NEXT_PUBLIC_* is
# inlined into the client bundle, so changing it rebuilds. See DEPLOYMENT.md.
# NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
