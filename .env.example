# Anthropic API key used for the safety classifier and card generation.
ANTHROPIC_API_KEY=sk-ant-...

# Model name used for both the safety classifier and the generator.
# Defaults to claude-sonnet-5-5 if unset.
MODEL_NAME=claude-sonnet-5-5

# ElevenLabs API key, used for speech-to-text on the "describe your
# situation" screen's mic button. Optional — the mic button is hidden if
# this isn't set.
ELEVENLABS_API_KEY=sk_...

# --- Better Auth (sign-in) ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=
# Deployed domain in production (e.g. https://kin-and-d.vercel.app). Auto-detected in dev.
AUTH_URL=
# Magic-link sign-in email, sent via Resend. If unset, the sign-in link is
# printed to the server console instead — handy for local dev without an
# email account, but RESEND_API_KEY must be set in production.
RESEND_API_KEY=
EMAIL_FROM="kin&d <noreply@yourdomain.com>"
# Optional "Continue with Google" sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Vercel Postgres / Neon) ---
POSTGRES_URL=
# Direct (non-pooled) connection string — drizzle-kit migrate needs this one.
POSTGRES_URL_NON_POOLING=

# --- Stripe (freemium billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
